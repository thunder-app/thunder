    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"username\" TEXT NULL, \"jwt\" TEXT NULL, \"instance\" TEXT NULL, \"anonymous\" INTEGER NOT NULL DEFAULT 0 CHECK (\"anonymous\" IN (0, 1)), \"user_id\" INTEGER NULL, \"list_index\" INTEGER NOT NULL DEFAULT -1, \"platform\" TEXT NULL);"
        }
      ]
    },
    {
