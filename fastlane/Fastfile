require "fileutils"
require "tmpdir"

skip_docs

THUNDER_ROOT = File.expand_path("..", __dir__)
ANDROID_METADATA = File.join(THUNDER_ROOT, "fastlane/metadata/android")

def release_artifact(path, extension)
  absolute = File.expand_path(path.to_s, THUNDER_ROOT)
  UI.user_error!("Provide an existing #{extension} file") unless File.file?(absolute) && File.extname(absolute) == extension
  absolute
end

def release_build(options)
  version = options[:version].to_s
  build_number = options[:build_number].to_s
  if version.empty? || !build_number.match?(/\A\d+(?:\.\d+){0,2}\z/)
    UI.user_error!("Provide version:<version> and build_number:<build number>")
  end
  [version, build_number]
end

def thunder_app_store_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]

  if key_id.to_s.empty? || issuer_id.to_s.empty?
    UI.user_error!("Set APP_STORE_CONNECT_API_KEY_ID and APP_STORE_CONNECT_ISSUER_ID")
  end

  credential = if !key_path.to_s.empty?
    { key_filepath: release_artifact(key_path, ".p8") }
  elsif !key_base64.to_s.empty?
    { key_content: key_base64, is_key_content_base64: true }
  else
    UI.user_error!("Set APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_BASE64")
  end

  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, **credential)
end

# Signs in to App Store Connect and returns the API key and Thunder's app.
def thunder_app
  api_key = thunder_app_store_key
  app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("App Store Connect could not find #{app_identifier}") unless app
  [api_key, app]
end

platform :android do
  desc "Upload a signed AAB to Google Play with notes:<file> as the release notes"
  lane :upload do |options|
    aab = release_artifact(options[:aab], ".aab")
    notes = release_artifact(options[:notes], ".txt")
    track = options.fetch(:track, "internal")

    Dir.mktmpdir("play-notes") do |notes_dir|
      changelogs = File.join(notes_dir, "en-US/changelogs")
      FileUtils.mkdir_p(changelogs)
      FileUtils.cp(notes, File.join(changelogs, "default.txt"))

      upload_to_play_store(
        aab: aab,
        metadata_path: notes_dir,
        track: track,
        # Production releases wait as a draft for a rollout in Play Console.
        release_status: track == "production" ? "draft" : "completed",
        validate_only: options.fetch(:validate_only, false),
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Update the Google Play listing copy, graphics, and screenshots"
  lane :metadata do |options|
    upload_to_play_store(
      metadata_path: ANDROID_METADATA,
      validate_only: options.fetch(:validate_only, false),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true
    )
  end
end

platform :ios do
  desc "Upload a signed IPA to App Store Connect for TestFlight"
  lane :upload do |options|
    upload_to_testflight(
      ipa: release_artifact(options[:ipa], ".ipa"),
      api_key: thunder_app_store_key,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Distribute an uploaded build to Thunder's external TestFlight groups with notes:<file>"
  lane :distribute do |options|
    version, build_number = release_build(options)
    notes = File.read(release_artifact(options[:notes], ".txt")).strip
    groups = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Set TESTFLIGHT_GROUPS to the external TestFlight group names or IDs") if groups.empty?

    api_key, app = thunder_app
    external_groups = app.get_beta_groups.reject(&:is_internal_group)
    unknown_groups = groups.reject { |group| external_groups.any? { |entry| entry.matches_identifiers?([group]) } }
    UI.user_error!("Unknown external TestFlight groups: #{unknown_groups.join(', ')}") unless unknown_groups.empty?

    upload_to_testflight(
      api_key: api_key,
      app_platform: "ios",
      app_version: version,
      build_number: build_number,
      distribute_only: true,
      distribute_external: true,
      groups: groups,
      changelog: notes
    )
  end

  desc "Submit an uploaded build to Apple for review with manual release"
  lane :submit do |options|
    version, build_number = release_build(options)

    api_key, app = thunder_app
    editable_version = app.get_edit_app_store_version
    unless editable_version && editable_version.version_string == version
      UI.user_error!("App Store Connect has no editable iOS version matching #{version}")
    end

    manual_release = Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
    editable_version.update(attributes: { releaseType: manual_release }) unless editable_version.release_type == manual_release

    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
